--- a/kernel/process.c
+++ b/kernel/process.c
@@ -20,6 +20,7 @@
 
 //Two functions defined in kernel/usertrap.S
 extern char smode_trap_vector[];
+extern uint64 page_ref[];
 extern void return_to_user(trapframe *, uint64 satp);
 
 // trap_sec_start points to the beginning of S-mode trap segment (i.e., the entry point
@@ -211,10 +212,17 @@ int do_fork( process* parent)
             if (free_block_filter[(heap_block - heap_bottom) / PGSIZE])  // skip free blocks
               continue;
 
-            void* child_pa = alloc_page();
-            memcpy(child_pa, (void*)lookup_pa(parent->pagetable, heap_block), PGSIZE);
-            user_vm_map((pagetable_t)child->pagetable, heap_block, PGSIZE, (uint64)child_pa,
-                        prot_to_type(PROT_WRITE | PROT_READ, 1));
+            pte_t *pte;
+            uint64 pa;
+            if((pte = page_walk(parent->pagetable, heap_block, 0)) == 0)
+              panic("pte not exist");
+            if((*pte & PTE_V) == 0)
+              panic("pte not avaluable");
+            pa = PTE2PA(*pte);
+            *pte = (*pte & ~PTE_W) | PTE_COW;
+            uint64 flags = PTE_FLAGS(*pte);
+            user_vm_map((pagetable_t)child->pagetable, heap_block, PGSIZE, pa, flags);
+            page_ref[COW_INDEX(pa)]++;;
           }
 
           child->mapped_info[HEAP_SEGMENT].npages = parent->mapped_info[HEAP_SEGMENT].npages;
diff --git a/kernel/riscv.h b/kernel/riscv.h
index 9668580..8bcafac 100644
--- a/kernel/riscv.h
+++ b/kernel/riscv.h
@@ -198,7 +198,8 @@ static inline void flush_tlb(void) { asm volatile("sfence.vma zero, zero"); }
 #define PTE_G (1L << 5)  // global
 #define PTE_A (1L << 6)  // accessed
 #define PTE_D (1L << 7)  // dirty
-
+#define PTE_COW (1L << 8)
+#define COW_INDEX(pa) (((uint64)(pa) - KERN_BASE) >> 12)
 // shift a physical address to the right place for a PTE.
 #define PA2PTE(pa) ((((uint64)pa) >> 12) << 10)
 
