diff --git a/kernel/pmm.c b/kernel/pmm.c
index c10e007..60089f9 100644
--- a/kernel/pmm.c
+++ b/kernel/pmm.c
@@ -21,7 +21,7 @@ typedef struct node {
 
 // g_free_mem_list is the head of the list of free physical memory pages
 static list_node g_free_mem_list;
-
+uint64 page_ref[(PHYS_TOP - KERN_BASE) / PGSIZE];
 //
 // actually creates the freepage list. each page occupies 4KB (PGSIZE), i.e., small page.
 // PGSIZE is defined in kernel/riscv.h, ROUNDUP is defined in util/functions.h.
@@ -39,6 +39,11 @@ void free_page(void *pa) {
   if (((uint64)pa % PGSIZE) != 0 || (uint64)pa < free_mem_start_addr || (uint64)pa >= free_mem_end_addr)
     panic("free_page 0x%lx \n", pa);
 
+  if(page_ref[COW_INDEX(pa)] > 1) { 
+    page_ref[COW_INDEX(pa)]--;
+    return;
+  }
+  page_ref[COW_INDEX(pa)] = 0;
   // insert a physical page to g_free_mem_list
   list_node *n = (list_node *)pa;
   n->next = g_free_mem_list.next;
@@ -52,7 +57,7 @@ void free_page(void *pa) {
 void *alloc_page(void) {
   list_node *n = g_free_mem_list.next;
   if (n) g_free_mem_list.next = n->next;
-
+  if (n) page_ref[COW_INDEX(n)] = 1;
   return (void *)n;
 }
 
diff --git a/kernel/process.c b/kernel/process.c
