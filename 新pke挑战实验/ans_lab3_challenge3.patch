diff --git a/kernel/vmm.c b/kernel/vmm.c
index 5647d8f..1347eab 100644
--- a/kernel/vmm.c
+++ b/kernel/vmm.c
@@ -207,6 +207,34 @@ void user_vm_unmap(pagetable_t page_dir, uint64 va, uint64 size, int free) {
 
 }
 
+int cow_alloc(pagetable_t pagetable, uint64 va) { 
+  va = ROUNDDOWN(va, PGSIZE);
+  
+  pte_t *pte = page_walk(pagetable, va, 0);
+  if(pte == 0)
+  {
+    panic("pte error");
+    return -1;
+  }
+  uint64 pa = PTE2PA(*pte);
+  if(pa == 0)
+  {
+    panic("pa error");
+    return -1;
+  }
+    
+  uint64 flags = PTE_FLAGS(*pte);
+  if(flags & PTE_COW) { 
+    uint64 mem = (uint64)alloc_page();
+    if (mem == 0)
+      return -1;
+    memcpy((void*)mem, (void*)pa, PGSIZE);
+    user_vm_unmap(pagetable, va, PGSIZE, 1);
+    flags = (flags | PTE_W) & ~PTE_COW;
+    user_vm_map(pagetable, va, PGSIZE, mem, flags);
+  }
+  return 0;
+}
