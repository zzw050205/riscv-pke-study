+ssize_t sys_user_wait(long pid) {
+  if (pid == -1) { // wait till all processes in system exit
+    int child_cnt = 0;
+    for (int i = 0; i < NPROC; ++i) {
+      if (procs[i].status == READY || procs[i].status == BLOCKED ||
+        procs[i].status == RUNNING) {
+        if (procs[i].parent == current) {
+          child_cnt++;
+          procs[i].is_waited = TRUE;
+        }
+      }
+    }
+    // doing nothing if current process is the only alive one
+    if (child_cnt == 0) {
+      return -1;
+    }
+    // sets the caller to BLOCKED status
+    current->status = BLOCKED;
+    schedule();
+  } else if (pid > 0) { // wait till process pid exits
+    if ( (pid>0) && (pid<NPROC) ) {
+      procs[pid].is_waited = TRUE;
+      current->status = BLOCKED;
+      schedule();
+    } else {
+      return -1;
+    }
+  }
+  return -1;
+}
