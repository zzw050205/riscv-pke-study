 //Two functions defined in kernel/usertrap.S
 extern char smode_trap_vector[];
@@ -264,3 +265,105 @@ int do_fork( process* parent)
 
   return child->pid;
 }
+
+//
+// release the elf segments in memory regions (for reload).
+//
+int release_elf_seg(process *proc) {
+  for (int i = 4; i < proc->total_mapped_region; i++) {
+    user_vm_unmap(proc->pagetable, proc->mapped_info[i].va, proc->mapped_info[i].npages * PGSIZE, 1);
+    proc->mapped_info[i].va = 0;
+  }
+  proc->total_mapped_region = 4;
+  return 0;
+}
+
+//
+// exec syscall in kernel.
+//
+int copyout(pagetable_t pagetable, uint64 dstva, char *src, uint64 len)
+{
+  uint64 n, va0, pa0;
+
+  while(len > 0) {
+    va0 = ROUNDDOWN(dstva, PGSIZE);
+    pa0 = lookup_pa(pagetable, va0);
+    if(pa0 == 0)
+      return -1;
+    n = PGSIZE - (dstva - va0);
+    if(n > len)
+      n = len;
+    memmove((void *)(pa0 + (dstva - va0)), src, n);
+
+    len -= n;
+    src += n;
+    dstva = va0 + PGSIZE;
+  }
+  return 0;
+}
+int do_exec(process* proc, char* path, char **argv) {
+  // check if the file exists.
+  struct file *exist = vfs_open(path, O_RDONLY);
+  vfs_close(exist);
+  if (exist == NULL) {
+    sprint("load_bincode_from_host_elf failed.\n");
+    return -1;
+  }
+
+  // release the elf segments in memory regions
+  release_elf_seg(proc);
+  // load the new elf segments into memory regions
+  load_bincode_from_host_elf(proc, path);
+  // set the user stack pointer
+
+  // added lab4_challenge3
+  uint64 argc = 0, sp, ustack[MAX_CMDLINE_ARGS];
+  sp = USER_STACK_TOP;
+  for (argc = 0; argv[argc]; argc++)
+  {
+    if (argc >= MAX_CMDLINE_ARGS)
+      return 0;
+    sp -= strlen(argv[argc]) + 1;
+    sp -= sp % 16;
+    
+    if(copyout(proc->pagetable, sp, argv[argc], strlen(argv[argc]) + 1) < 0)
+      return -1;
+    
+    ustack[argc] = sp;
+  }
+  ustack[argc] = 0;
+  sp -= (argc+1) * sizeof(uint64);
+  sp -= sp % 16;
+  
+  if(copyout(proc->pagetable, sp, (char *)ustack, (argc+1)*sizeof(uint64)) < 0)
+    return -1;
+
+  proc->trapframe->regs.a1 = sp;
+  proc->trapframe->regs.sp = sp;
+
+  // reset the heap
+  // convert free_pages_address into a filter to skip reclaimed blocks in the heap
+  // when mapping the heap blocks
+  int free_block_filter[MAX_HEAP_PAGES];
+  memset(free_block_filter, 0, MAX_HEAP_PAGES);
+  uint64 heap_bottom = proc->user_heap.heap_bottom;
+  for (int i = 0; i < proc->user_heap.free_pages_count; i++) {
+    int index = (proc->user_heap.free_pages_address[i] - heap_bottom) / PGSIZE;
+    free_block_filter[index] = 1;
+  }
+
+  // free the heap blocks
+  for (uint64 heap_block = current->user_heap.heap_bottom;
+        heap_block < current->user_heap.heap_top; heap_block += PGSIZE) {
+    if (free_block_filter[(heap_block - heap_bottom) / PGSIZE])  // skip free blocks
+      continue;
+    user_vm_unmap((pagetable_t)proc->pagetable, heap_block, PGSIZE, 1);
+  }
+  proc->mapped_info[3].npages = 0;
+
+  // reset the heap manager
+  proc->user_heap.free_pages_count = 0;
+  proc->user_heap.heap_top = proc->user_heap.heap_bottom;
+  
+  return argc;
+}
